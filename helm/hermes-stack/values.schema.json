{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["architecture", "storageClass", "existingSecret", "llm"],
  "allOf": [
    {"if": {"properties": {"llm": {"properties": {"context": {"maximum": 63999}}}}},
     "then": {"properties": {"hermes": {"properties": {"allowSmallContext": {"const": true}}}}},
     "else": {"properties": {"hermes": {"properties": {"allowSmallContext": {"const": false}}}}}}
  ],
  "properties": {
    "architecture": {"enum": ["arm64"]},
    "storageClass": {"type": "string", "minLength": 1},
    "existingSecret": {"type": "string", "minLength": 1},
    "hermes": {"type": "object", "properties": {"allowSmallContext": {"type": "boolean"}}},
    "llm": {"type": "object", "properties": {
      "context": {"type": "integer", "minimum": 1024, "maximum": 131072},
      "parallel": {"type": "integer", "minimum": 1, "maximum": 1},
      "threads": {"type": "integer", "minimum": 1},
      "batch": {"type": "integer", "minimum": 1},
      "model": {"type": "object", "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.gguf$"}
      }}
    }}
  }
}
